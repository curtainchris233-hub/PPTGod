{
  "name": "pptgod",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/check-runtime.mjs && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test:e2e": "python3 tests/e2e/glacier_v2/run_glacier_e2e.py --tier all --backup-db",
    "test:e2e:list": "python3 tests/e2e/glacier_v2/run_glacier_e2e.py --list",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:import-sqlite": "tsx scripts/db-import-sqlite.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.95",
    "@aws-sdk/client-s3": "3.1178.0",
    "@better-auth/drizzle-adapter": "1.7.28",
    "@mastra/core": "1.86.0",
    "@upstash/redis": "1.41.1",
    "better-auth": "1.7.28",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.79.0",
    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "pptxgenjs": "^4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "7.30.2",
    "unpdf": "^1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "4.20.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "pptxgenjs": {
      "image-size": "2.1.0"
    }
  }
}
