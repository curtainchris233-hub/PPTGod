# Docker Compose starts a local PostgreSQL database with these credentials.
DATABASE_URL=postgresql://pptgod:pptgod@127.0.0.1:5432/pptgod
# Hosted deployments can use a separate migration connection.
# DATABASE_MIGRATION_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Enable server-side storage, rate limiting and email checks for hosted releases.
# PPTGOD_REQUIRE_SERVICES=true
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="PPTGod <hello@notify.example.com>"
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional site-wide AI. Without these, users can connect their own model.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# OPENAI_IMAGE_API_KEY=
# OPENAI_IMAGE_MODEL=

# Local development only.
# PPTGOD_ENABLE_DEMO_ACCOUNT=true
